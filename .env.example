# IDs and model revisions are recorded in each run's metadata.json.
QVC_SPEAKER_ID=my_voice
QVC_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QVC_TOKENIZER_ID=Qwen/Qwen3-TTS-Tokenizer-12Hz
QVC_MODEL_REVISION=main

# RunPod A100-80GB budget guard. Verify the current price before starting a pod.
QVC_GPU_NAME=A100-80GB
QVC_GPU_HOURLY_USD=1.39
QVC_BUDGET_USD=10
QVC_MAX_GPU_HOURS=6
QVC_SMOKE_GPU_HOURS=0.5
# The six-hour provider auto-stop covers smoke (0.5) + run (4.5) + evaluation (1.0).
QVC_FULL_GPU_HOURS=4.5
QVC_EVALUATION_GPU_HOURS=1.0

# Paths on the A100 machine. These are intentionally unrelated to CosyVoice.
QVC_QWEN_REPO_DIR=/workspace/Qwen3-TTS
QVC_WORKSPACE_DIR=/workspace/qwen3tts-voiceclone

# RunPod: set WANDB_API_KEY as a RunPod Secret, never here.  Use offline to retain
# logs on the volume when you do not want to use the W&B hosted dashboard.
QVC_WANDB_MODE=online
QVC_WANDB_PROJECT=qwen3tts-voiceclone
QVC_GPU_POLL_SECONDS=20
