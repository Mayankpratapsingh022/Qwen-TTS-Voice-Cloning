# Source before either RunPod script: set -a; source profiles/runpod-rtx-5090-32gb.env; set +a
# $0.99/h × 6 h = $5.94 maximum GPU compute. Set the RunPod auto-stop to 6 h.
QVC_GPU_NAME=RTX-5090-32GB
QVC_GPU_HOURLY_USD=0.99
QVC_BUDGET_USD=10
QVC_MAX_GPU_HOURS=6
QVC_SMOKE_GPU_HOURS=0.5
QVC_FULL_GPU_HOURS=4.5
QVC_EVALUATION_GPU_HOURS=1.0
