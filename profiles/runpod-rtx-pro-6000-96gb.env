# Source before either RunPod script: set -a; source profiles/runpod-rtx-pro-6000-96gb.env; set +a
# $1.89/h × 5.2 h = $9.83 maximum GPU compute. Set the RunPod auto-stop to 5 h 12 min.
QVC_GPU_NAME=RTX-PRO-6000-Blackwell-96GB
QVC_GPU_HOURLY_USD=1.89
QVC_BUDGET_USD=10
QVC_MAX_GPU_HOURS=5.2
QVC_SMOKE_GPU_HOURS=0.4
QVC_FULL_GPU_HOURS=3.9
QVC_EVALUATION_GPU_HOURS=0.9
